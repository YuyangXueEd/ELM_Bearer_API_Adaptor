# Copy to .env and use your own ELM key. Never commit .env.
ELM_API_KEY=replace-with-your-elm-key
ELM_MODEL=gpt-5.3-codex
# Generate a separate local token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ELM_ADAPTOR_TOKEN=replace-with-a-random-local-token
ELM_ADAPTOR_PORT=8787
